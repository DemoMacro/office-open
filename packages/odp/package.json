  "dependencies": {
    "@office-open/core": "workspace:*",
    "@office-open/ocf": "workspace:*",
    "@office-open/odf-schema": "workspace:*",
    "@office-open/pptx": "workspace:*",
    "@office-open/xml": "workspace:*"
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "skipLibCheck": true,
    "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    "strictNullChecks": true,
    "sourceMap": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "paths": {
      "@parts/*": ["./src/parts/*"],
      "@shared/*": ["./src/shared/*"],
      "@util/*": ["./src/util/*"],
      "@export/*": ["./src/export/*"],
      "@office-open/core": ["../core/src/index.ts"],
      "@office-open/core/*": ["../core/src/*/index.ts"],
      "@office-open/xml": ["../xml/src/index.ts"]
    }
  },
  "include": ["src", "demo"]
}

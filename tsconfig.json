{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "declaration": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "sourceMap": true,
    "paths": {
      "@office-open/core": ["./packages/core/src/index.ts"],
      "@office-open/core/*": ["./packages/core/src/*/index.ts"],
      "@office-open/xml": ["./packages/xml/src/index.ts"],
      "@office-open/ocf": ["./packages/ocf/src/index.ts"],
      "@office-open/odf-schema": ["./packages/odf-schema/src/index.ts"],
      "@office-open/odt": ["./packages/odt/src/index.ts"],
      "@office-open/ods": ["./packages/ods/src/index.ts"],
      "@office-open/odp": ["./packages/odp/src/index.ts"],
      "@office-open/xml/*": ["./packages/xml/src/*/index.ts"],
      "@office-open/docx": ["./packages/docx/src/index.ts"],
      "@office-open/pptx": ["./packages/pptx/src/index.ts"],
      "@office-open/xlsx": ["./packages/xlsx/src/index.ts"]
    }
  }
}

  "dependencies": {
    "@office-open/docx": "workspace:*",
    "@office-open/pptx": "workspace:*",
    "@office-open/xlsx": "workspace:*",
    "@office-open/xml": "workspace:*",
    "fflate": "0.8.3"
  }
}

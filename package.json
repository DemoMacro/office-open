{
  "name": "@office-open/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native Office documents for TypeScript and JavaScript — generate, parse, and patch .docx, .xlsx, .pptx from plain JSON",
  "keywords": [
    "ai",
    "docx",
    "office",
    "office-open",
    "ooxml",
    "pptx",
    "typescript",
    "xlsx"
  ],
  "homepage": "https://www.office-open.com",
  "bugs": {
    "url": "https://github.com/DemoMacro/office-open/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Demo Macro",
    "email": "abc@imst.xyz",
    "url": "https://www.demomacro.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemoMacro/office-open.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" -r dev",
    "build": "pnpm --filter \"./packages/**\" -r build",
    "check": "pnpm --filter @office-open/docs exec nuxt prepare && vp check --fix",
    "test": "pnpm --filter \"./packages/**\" -r test",
    "postinstall": "pnpm build && vp config && basis git setup",
    "corpus:setup": "tsx scripts/corpus/check.ts --setup",
    "corpus:check": "tsx scripts/corpus/check.ts",
    "corpus:legacy": "tsx scripts/corpus/legacy.ts",
    "coverage:xsd": "tsx scripts/coverage/xsd.ts --summary",
    "coverage:xsd-runtime": "tsx scripts/coverage/xsd-runtime.ts",
    "coverage:ooxml-executable": "tsx scripts/coverage/ooxml-executable.ts",
    "coverage:canonical": "tsx scripts/coverage/canonical.ts --summary",
    "coverage:odf": "tsx scripts/coverage/odf.ts",
    "coverage:legacy": "tsx scripts/coverage/legacy.ts",
    "gates:boundaries": "tsx scripts/gates/package-boundaries.ts",
    "gates:containers": "tsx scripts/gates/containers.ts",
    "gates:cross-format": "tsx scripts/gates/cross-format.ts",
    "gates:docs-parity": "tsx scripts/gates/docs-parity.ts",
    "gates:outputs": "tsx scripts/gates/package-outputs.ts",
    "models:generate": "tsx scripts/models/generate.ts",
    "models:check": "tsx scripts/models/generate.ts --check",
    "schema:generate": "tsx scripts/schema/generate.ts && vp fmt packages/office-open/schemas",
    "schema:check": "tsx scripts/schema/generate.ts --check",
    "schema:validate": "tsx scripts/schema/validate.ts",
    "validate:ooxml": "tsx scripts/validation/ooxml.ts",
    "validate:odf": "tsx scripts/validation/odf.ts",
    "version": "pnpm --filter \"./packages/**\" -r exec basis version",
    "publish": "pnpm --filter \"./packages/**\" -r exec basis publish",
    "docs:dev": "pnpm --filter @office-open/docs dev",
    "docs:build": "pnpm --filter @office-open/docs build",
    "docs:generate": "pnpm --filter @office-open/docs generate",
    "docs:preview": "pnpm --filter @office-open/docs preview"
  },
  "devDependencies": {
    "@funish/basis": "0.3.0",
    "@rolldown/plugin-node-polyfills": "1.0.3",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "docx": "9.8.1",
    "execa": "10.0.1",
    "happy-dom": "20.14.5",
    "hucre": "1.1.0",
    "inquirer": "14.2.2",
    "libxml2-wasm": "0.7.2",
    "pptxgenjs": "4.0.1",
    "ts-json-schema-generator": "2.9.0",
    "ts-morph": "28.0.0",
    "tsx": "4.23.15",
    "vite-plus": "0.1.24"
  },
  "packageManager": "pnpm@10.33.0"
}
